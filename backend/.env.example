# ---------------------------------------------------------------------------
# GramSahayak backend configuration. Copy to .env and fill in what you need.
# Never commit the real .env file.
# ---------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# Database. Leave empty to run on the built-in in-memory demo store
# (data resets when the process restarts). In production, set this.
# Atlas format: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/gramsahayak
MONGODB_URI=

# Browser origins allowed by CORS (comma separated). Native Android sends no
# Origin header, so the app is unaffected. Example: https://admin.example.com
CORS_ORIGIN=

# ---------------------------------------------------------------------------
# SPEECH TO TEXT (the Virtual Call screen)
#
# Set ANY ONE of the three blocks below and the voice screen works.
# With none of them, a voice turn returns the text answer plus a notice, and
# the Ask screen (phone-side speech recognition) keeps working as before.
# ---------------------------------------------------------------------------

# 1) Sarvam AI — Indian languages, one HTTPS call, no storage bucket needed.
#    Sign up at sarvam.ai, copy the key from the dashboard.
SARVAM_API_KEY=
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
SARVAM_STT_MODEL=saarika:v2.5

# 2) Any OpenAI-compatible /audio/transcriptions endpoint
#    (OpenAI Whisper, Groq Whisper, a self-hosted Whisper server).
#    Example: STT_HTTP_URL=https://api.openai.com/v1/audio/transcriptions
STT_HTTP_URL=
STT_HTTP_API_KEY=
STT_HTTP_MODEL=whisper-1

# 3) Amazon Transcribe. Needs credentials AND a bucket to stage the clip.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed for temporary (STS) credentials
AWS_SESSION_TOKEN=
AWS_S3_BUCKET=

# auto = try sarvam -> http -> aws, whichever is configured.
# sarvam | http | aws = use only that one. off = never transcribe.
STT_PROVIDER=auto
# auto | aws | off — controls whether AWS (Polly / Transcribe) may be used at all
SPEECH_PROVIDER=auto
SPEECH_TIMEOUT_MS=25000
MAX_AUDIO_BYTES=8388608

# Spoken replies use Amazon Polly and need AWS credentials. Without them a
# voice turn returns the text answer, which the app already displays.

# ---------------------------------------------------------------------------
# Optional answer rewriting with Amazon Bedrock. Leave empty to use the
# built-in extractive answers from the knowledge base (no cost, no latency).
# Example: anthropic.claude-3-haiku-20240307-v1:0  or  amazon.nova-lite-v1:0
# ---------------------------------------------------------------------------
BEDROCK_MODEL_ID=
BEDROCK_REGION=

# How old a downloaded knowledge pack may be before the app warns the user
PACK_MAX_AGE_DAYS=14

# SMS is simulated only. Set to false to disable the SMS demo endpoints.
ALLOW_SMS_SIMULATION=true
